<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-versioned TFM so WebView2CompositionControl's WinRT projections
         (Microsoft.Windows.SDK.NET) are available for airspace-free composition rendering. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GleapSDK.WebView2</RootNamespace>
    <AssemblyName>Gleap.WebView2</AssemblyName>
  </PropertyGroup>

  <!-- NuGet package metadata (proprietary license: use PackageLicenseFile, not an SPDX expression). -->
  <PropertyGroup>
    <PackageId>Gleap.WebView2</PackageId>
    <Description>Gleap SDK for Windows (WPF) — a drop-in WebView2 messenger control for in-app feedback, bug reporting, surveys, product tours and live chat, matching the Gleap web widget on the desktop.</Description>
    <PackageProjectUrl>https://gleap.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GleapSDK/CSharp-SDK</RepositoryUrl>
    <PackageTags>gleap;feedback;bug-reporting;wpf;windows;webview2;survey;support;live-chat</PackageTags>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Version floats to latest 1.0.x; pin after the first successful Windows restore. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gleap.Core\Gleap.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
