<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-versioned TFM so WebView2CompositionControl's WinRT projections
         (Microsoft.Windows.SDK.NET) are available for airspace-free composition rendering. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GleapSDK.WebView2</RootNamespace>
    <AssemblyName>Gleap.WebView2</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Version floats to latest 1.0.x; pin after the first successful Windows restore. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gleap.Core\Gleap.Core.csproj" />
  </ItemGroup>

</Project>
