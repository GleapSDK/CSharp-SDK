<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>GleapSDK.Extensions.Logging</RootNamespace>
    <AssemblyName>Gleap.Extensions.Logging</AssemblyName>
  </PropertyGroup>

  <!-- NuGet package metadata (proprietary license: use PackageLicenseFile, not an SPDX expression). -->
  <PropertyGroup>
    <PackageId>Gleap.Extensions.Logging</PackageId>
    <Description>Gleap SDK logging integration — an ILogger provider that forwards Microsoft.Extensions.Logging output into the Gleap session log, so console/network/log context is attached to feedback and bug reports.</Description>
    <PackageProjectUrl>https://www.gleap.ai</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GleapSDK/CSharp-SDK</RepositoryUrl>
    <PackageTags>gleap;feedback;bug-reporting;logging;ilogger;microsoft-extensions-logging</PackageTags>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gleap.Core\Gleap.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gleap.Core.Tests" />
  </ItemGroup>

</Project>
