<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>GleapSDK.Maui</RootNamespace>
    <AssemblyName>Gleap.Maui</AssemblyName>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- NuGet package metadata (proprietary license: use PackageLicenseFile, not an SPDX expression). -->
  <PropertyGroup>
    <PackageId>Gleap.Maui</PackageId>
    <Description>Gleap SDK for .NET MAUI — in-app feedback, bug reporting, surveys, product tours and live chat on Android, iOS, MacCatalyst and Windows.</Description>
    <PackageProjectUrl>https://gleap.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GleapSDK/CSharp-SDK</RepositoryUrl>
    <PackageTags>gleap;feedback;bug-reporting;maui;android;ios;survey;support;live-chat</PackageTags>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gleap.Core\Gleap.Core.csproj" />
  </ItemGroup>

  <!-- [Java.Interop.Export] on the Android bridge's gleapCallback lives in Mono.Android.Export,
       which is not referenced by default; without it the Android TFM fails to compile (CS0246). -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <Reference Include="Mono.Android.Export" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
