<Window x:Class="GleapSDK.Sample.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gleap="clr-namespace:GleapSDK.WebView2;assembly=Gleap.WebView2"
        Title="Acme Dashboard — Gleap demo" Height="860" Width="1280">

    <!-- This whole window is a mock host application. Gleap is initialized in code
         (see MainWindow.xaml.cs), exactly like Gleap.initialize("KEY") in the JS SDK,
         and the floating launcher appears bottom-right on top of the app. -->
    <Grid Background="#F4F5F7">
        <StackPanel Margin="56,52,56,0" VerticalAlignment="Top" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Acme Dashboard" FontSize="32" FontWeight="Bold" Foreground="#141414" />
            <TextBlock Margin="0,12,0,0" Foreground="#5A5A5A" FontSize="15" TextWrapping="Wrap"
                       Text="This window represents your application. Gleap is initialized in code — no setup UI. The support messenger opens from the floating button in the bottom-right corner and closes back to it, just like the web SDK." />

            <Border Margin="0,28,0,0" Padding="20" Background="White" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="Recent activity" FontWeight="SemiBold" FontSize="15" Foreground="#141414" />
                    <TextBlock Margin="0,8,0,0" Foreground="#6A6A6A" FontSize="13" Text="• Deployment #482 succeeded" />
                    <TextBlock Margin="0,4,0,0" Foreground="#6A6A6A" FontSize="13" Text="• 3 new sign-ups today" />
                    <TextBlock Margin="0,4,0,0" Foreground="#6A6A6A" FontSize="13" Text="• Nightly backup completed" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- The reusable Gleap launcher + messenger overlay. -->
        <gleap:GleapMessenger x:Name="Messenger" />
    </Grid>
</Window>
