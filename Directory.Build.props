<Project>
  <PropertyGroup>
    <!-- Single source of truth for every packable project's NuGet version. Keep in step with
         GleapSDK.Gleap.Version (the runtime-reported SDK version) and the Unity package.json. -->
    <Version>0.1.0-beta.1</Version>
    <Authors>Gleap GmbH</Authors>
    <Company>Gleap GmbH</Company>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML doc) stays a warning, not an error, so TDD tasks aren't brittle;
         the -warnaserror quality gate in the DoD is run explicitly at the end. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
